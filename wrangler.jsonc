// Cloudflare Pages sozlamalari. Joylash: npm run deploy:cf
// Sirlar (DATABASE_URL, JWT_SECRET, ADMIN_PASSWORD) bu faylda emas —
// `npx wrangler pages secret put <NOM>` bilan qo'yiladi.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doss-uz",
  "pages_build_output_dir": "./dist-cf/site",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}
